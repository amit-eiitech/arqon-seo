{
  "name": "eii/arqon-seo",
  "description": "A flexible SEO metadata manager for Laravel and Filament.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/support": "^13.0",
    "illuminate/view": "^13.0",
    "filament/filament": "^5.0",
    "spatie/laravel-settings": "^3.4"
  },
  "autoload": {
    "psr-4": { "Arqon\\Seo\\": "src/" }
  },
  "extra": {
    "laravel": { "providers": ["Arqon\\Seo\\ArqonSeoServiceProvider"] }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
